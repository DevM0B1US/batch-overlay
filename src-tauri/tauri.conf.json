{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Batch Overlay",
  "version": "0.1.0",
  "identifier": "com.batchoverlay.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Batch Overlay",
        "width": 1020,
        "height": 700,
        "minWidth": 880,
        "minHeight": 620,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Batch image overlay tool",
    "longDescription": "Overlay a template image on top of every image in a folder. Fast batch processing built with Tauri v2.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
